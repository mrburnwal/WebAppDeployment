{
    "family": "webappdevelopemnt-taskdefinition-prod",
    "containerDefinitions": [
        {
            "name": "webappdevelopemnt",
            "image": "535032367236.dkr.ecr.us-east-1.amazonaws.com/myjenkinsapp:##IMAGE_NUMBER_TAG##",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "name": "nginx-80-tcp"
