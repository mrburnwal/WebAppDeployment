pipeline {
    agent any

    environment {
        NETLIFY_PROJECT_ID = "1bcc6f8d-5e6d-4ce7-8169-7ad1ab42433e"
        NETLIFY_AUTH_TOKEN = credentials('netlify_webapp_token')
        AWS_DEFAULT_REGION = "us-east-1"
    }

    stages {

        stage("AWS ECS Deploy") {
            agent {
                docker {
                    image "amazon/aws-cli:latest"
                    reuseNode true
                    args "-r root --entrypoint ''"
                }
            }

            steps {
                withCredentials([
                    aws(
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        credentialsId: 's3-aws key',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        aws --version
                        yum install jq -y
                        AWS_TD_REVISION=$(aws ecs register-task-definition --cli-input-json file://AWS-Resources/taskDefinition-prod.json | jq .taskDefinition.revision)
                        echo $AWS_TD_REVISION
                        aws ecs update-service --cluster webappdevelopment-cluster-prod --service webappdevelopemnt-service-prod --task-definition webappdevelopemnt-taskdefinition-prod:$AWS_TD_REVISION

                    '''
                }
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'my-playwirght'
                    reuseNode true
                    args "-e HOME=.cache"
                }
            }
            steps {
                sh '''
                    ls -la
                    node --version
                    npm --version
                    npm ci
                    npm run build
                    ls -la
                '''
            }
        }


    }
}