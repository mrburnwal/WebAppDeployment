pipeline {
    agent any

    environment {
        NETLIFY_PROJECT_ID = "1bcc6f8d-5e6d-4ce7-8169-7ad1ab42433e"
        NETLIFY_AUTH_TOKEN = credentials('netlify_webapp_token')
        AWS_DEFAULT_REGION = "us-east-1"
        BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }

    stages {
        stage("Print Build Number") {
            steps {
                echo "Build Number: $BUILD_NUMBER"
            }
        }
        stage('Build') {
            agent {
                docker {
                    image 'my-playwirght'
                    reuseNode true
                    args "-e HOME=.cache"
                }
            }
            steps {
                sh '''
                    ls -la
                    node --version
                    npm --version
                    npm ci
                    npm run build
                    ls -la
                '''
            }
        }

        stage('Build Docker Image') {
            agent {
                docker {
                    image "my-aws-cli"
                    reuseNode true
                    args "-u root -v /var/run/docker.sock:/var/run/docker.sock --entrypoint ''"
                }
            }

            steps {
                withCredentials([
                    aws(
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        credentialsId: 's3-aws key',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        docker build -t 535032367236.dkr.ecr.us-east-1.amazonaws.com/myjenkinsapp:${BUILD_NUMBER} .
                        aws ecr get-login-password | docker login --username AWS --password-stdin 535032367236.dkr.ecr.us-east-1.amazonaws.com
                        docker push 535032367236.dkr.ecr.us-east-1.amazonaws.com/myjenkinsapp:${BUILD_NUMBER}
                    ''' 
                }
            }
        }

        stage("AWS ECS Deploy") {
            agent {
                docker {
                    image "my-aws-cli"
                    reuseNode true
                    args "-u root --entrypoint ''"
                }
            }

            steps {
                withCredentials([
                    aws(
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        credentialsId: 's3-aws key',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        aws --version
                        AWS_TD_REVISION=$(aws ecs register-task-definition --cli-input-json file://AWS-Resources/taskDefinition-prod.json | jq .taskDefinition.revision)
                        echo $AWS_TD_REVISION
                        aws ecs update-service --cluster webappdevelopment-cluster-prod --service webappdevelopemnt-service-prod --task-definition webappdevelopemnt-taskdefinition-prod:$AWS_TD_REVISION

                    '''
                }
            }
        }


    }
}